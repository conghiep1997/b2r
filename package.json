{
  "name": "backlog2redmine",
  "version": "1.8.24",
  "description": "Chrome extension to translate and sync comments between Backlog and Redmine",
  "scripts": {
    "bump": "node scripts/bump-version.js",
    "check:version-sync": "node scripts/check-version-sync.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json,html,css}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"manifest.json\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{js,json,html,css}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"manifest.json\" \"package.json\"",
    "build": "npm run check:version-sync && npm run lint && npm run format:check && node scripts/build.js",
    "build:zip": "node scripts/build-zip.js",
    "sync:version": "node scripts/sync-version.js",
    "release": "npm run build:zip && npm run sync:version",
    "test": "node --test tests/*.test.js",
    "verify": "npm run check:version-sync && npm run lint && npm run format:check && npm test && npm run build",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "dev": "echo \"Load unpacked extension from dist/ folder in chrome://extensions/\""
  },
  "keywords": [
    "backlog",
    "redmine",
    "translation",
    "chrome-extension",
    "productivity"
  ],
  "author": "Hipppo",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "archiver": "^7.0.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conghiep1997/b2r.git"
  },
  "bugs": {
    "url": "https://github.com/conghiep1997/b2r/issues"
  },
  "homepage": "https://github.com/conghiep1997/b2r#readme"
}
